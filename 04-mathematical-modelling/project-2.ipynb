   "source": [
    "import sympy.plotting as sp_plot\n",
    "from sympy.plotting import PlotGrid\n",
    "\n",
    "# Eigenvalue for equilibrium 1:\n",
    "def eigenvalue_eq1():\n",
    "    J_eq = jacobian.subs({R: eq_pts[0][0], F: eq_pts[0][1]})\n",
    "    ev_eq1 = J_eq.eigenvals()\n",
    "    ev1_eq1 = sp.simplify(list(ev_eq1)[0])\n",
    "    ev2_eq1 = sp.simplify(list(ev_eq1)[1])\n",
    "    return ev1_eq1, ev2_eq1\n",
    "\n",
    "# Eigenvalue for equilibrium 2:\n",
    "def eigenvalue_eq2():\n",
    "    J_eq = jacobian.subs({R: eq_pts[1][0], F: eq_pts[1][1]})\n",
    "    ev_eq2 = J_eq.eigenvals()\n",
    "    ev1_eq2 = sp.simplify(list(ev_eq2)[0])\n",
    "    ev2_eq2 = sp.simplify(list(ev_eq2)[1])\n",
    "    return ev1_eq2, ev2_eq2\n",
    "\n",
    "# Eigenvalue for equilibrium 3:\n",
    "def eigenvalue_eq3():\n",
    "    J_eq = jacobian.subs({R: eq_pts[2][0], F: eq_pts[2][1]})\n",
    "    ev_eq3 = J_eq.eigenvals()\n",
    "    ev1_eq3 = sp.simplify(list(ev_eq3)[0])\n",
    "    ev2_eq3 = sp.simplify(list(ev_eq3)[1])\n",
    "    return ev1_eq3, ev2_eq3\n",
    "\n",
    "# Eigenvalue for equilibrium 4:\n",
    "def eigenvalue_eq4():\n",
    "    J_eq = jacobian.subs({R: eq_pts[3][0], F: eq_pts[3][1]})\n",
    "    ev_eq4 = J_eq.eigenvals()\n",
    "    ev1_eq4 = sp.simplify(list(ev_eq4)[0])\n",
    "    ev2_eq4 = sp.simplify(list(ev_eq4)[1])\n",
    "    return ev1_eq4, ev2_eq4\n",
    "\n",
    "# For equilibrium point 1\n",
    "Ev1, Ev2 = eigenvalue_eq1()\n",
    "p1 = sp_plot.plot(Ev1, Ev2, (K_R, 100, 3000),title=\"Equilibrium Point 1\")\n",
    "\n",
    "# For equilibrium point 2\n",
    "Ev1, Ev2 = eigenvalue_eq2()\n",
    "p2 = sp_plot.plot(Ev1, Ev2, (K_R, 100, 3000),title=\"Equilibrium Point 2\")\n",
    "# Find x intercept of the first eigenvalue\n",
    "x_intercept = sp.solve(Ev1, K_R)\n",
    "print(f\"X intercept of first eigenvalue: {x_intercept}\")\n",
    "\n",
    "# For equilibrium point 3\n",
    "Ev1, Ev2 = eigenvalue_eq3()\n",
    "p3 = sp_plot.plot(Ev1, Ev2, (K_R, 100, 3000),title=\"Equilibrium Point 3\")\n",
    "\n",
    "# For equilibrium point 4\n",
    "Ev1, Ev2 = eigenvalue_eq4()\n",
    "p4 = sp_plot.plot(re(Ev1), re(Ev2), (K_R, 100, 3000),title=\"Equilibrium Point 4\")\n",
    "# Find x intercept of the second eigenvalue\n",
    "x_intercept = sp.solve(Ev2, K_R)\n",
    "print(f\"X intercept of second eigenvalue: {x_intercept}\")\n",
    "\n",
    "# combine images into one big image\n",
    "# Combine into a 2x2 grid\n",
    "combined_plot = PlotGrid(2, 2, p1, p2, p3, p4)\n",
    "combined_plot.show()"
   ]
