   "source": [
    "# Checking stability of equilibrium point 3 at K_R = 374,375,376\n",
    "\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "from numpy.linalg import eigvals\n",
    "from sympy import *\n",
    "import sympy as sp\n",
    "import math\n",
    "\n",
    "R= symbols('R')\n",
    "F= symbols('F')\n",
    "K_R = symbols('K_R')\n",
    "rR    = 2.0      \n",
    "alpha = 0.01     \n",
    "bF    = 1/4      \n",
    "B     = 1500.0 \n",
    "\n",
    "\n",
    "dRdt = rR * R * (1 - R/K_R) - rR * alpha * R * F\n",
    "\n",
    "dFdt= (1/B) * R * F - bF * F\n",
    "\n",
    "eq_pts = solve([dRdt, dFdt], (R, F))\n",
    "eq_pts.append((375,0))\n",
    "# swap element 3 and 4 \n",
    "eq_pts[2], eq_pts[3] = eq_pts[3], eq_pts[2]\n",
    "print(eq_pts)\n",
    "\n",
    "jacobian = sp.Matrix([[diff(dRdt, R), diff(dRdt, F)],\n",
    "                     [diff(dFdt, R), diff(dFdt, F)]])\n",
    "\n",
    "def f(R, F, K_R):\n",
    "    return 2 * R * (1 - R / K_R) - 0.02 * R * F\n",
    "\n",
    "def g(R, F):\n",
    "    return (R * F / 1500) - (F / 4)\n",
    "\n",
    "K_R_list=[374, 375, 376]\n",
    "\n",
    "for i in K_R_list:\n",
    "    K_R_value = i\n",
    "    R_limit = K_R_value\n",
    "    F_limit = 100\n",
    "\n",
    "    # find eigenvalue and sub in K_R into the jacobian\n",
    "    def eigenvalue_eq3():\n",
    "        J_eq = jacobian.subs({R: eq_pts[2][0], F: eq_pts[2][1], K_R: K_R_value})\n",
    "        ev_eq1 = J_eq.eigenvals()\n",
    "        ev1_eq1 = sp.simplify(list(ev_eq1)[0])\n",
    "        ev2_eq1 = sp.simplify(list(ev_eq1)[1])\n",
    "        return ev1_eq1, ev2_eq1\n",
    "    ev1_eq3, ev2_eq3 = eigenvalue_eq3()\n",
    "    print(f\"Eigenvalues for equilibrium point 3: {ev1_eq3}, {ev2_eq3}\")\n",
    "\n",
    "    # find eigenvector\n",
    "    def eigenvector_eq3():\n",
    "        J_eq = jacobian.subs({R: eq_pts[2][0], F: eq_pts[2][1], K_R: K_R_value})\n",
    "        ev_eq3 = J_eq.eigenvects()\n",
    "        ev1_eq3 = sp.simplify(list(ev_eq3)[0])\n",
    "        ev2_eq3 = sp.simplify(list(ev_eq3)[1])\n",
    "        return ev1_eq3, ev2_eq3\n",
    "\n",
    "    evector1,evector2 = eigenvector_eq3()\n",
    "    \n",
    "\n",
    "\n",
    "    R_range = np.linspace(0, R_limit, 10)\n",
    "    F_range = np.linspace(0, F_limit, 10)\n",
    "\n",
    "    X1, X2 = np.meshgrid(R_range, F_range)\n",
    "\n",
    "    U = f(X1, X2, K_R_value)\n",
    "    V = g(X1, X2)\n",
    "\n",
    "    t_list = np.linspace(0,5,100)\n",
    "\n",
    "    def x1_func(c1, c2, t):\n",
    "        lx1 = c1*float(evector1[2][0][0]) * np.exp(float(ev1_eq3)*t) + c2*float(evector2[2][0][0]) * np.exp(float(ev2_eq3)*t)\n",
    "        return lx1\n",
    "\n",
    "    def x2_func(c1, c2, t):\n",
    "        lx2 = c1*float(evector1[2][0][1]) * np.exp(float(ev1_eq3)*t) + c2*float(evector2[2][0][1]) * np.exp(float(ev2_eq3)*t)\n",
    "        return lx2\n",
    "\n",
    "\n",
    "    C_list = [(3, -1.5), (-3, 1.5), (-1.5, 0), (1.5,0), (0,-1), (0,1), (1.0,0.4),(-1.0,-0.4)]\n",
    "    import matplotlib.pyplot as plt\n",
    "    plt.rcParams[\"figure.figsize\"] = (15,10)\n",
    "    for c in C_list:\n",
    "        plt.plot(x1_func(c[0], c[1], t_list), x2_func(c[0], c[1], t_list), linewidth=2.5)\n",
    "    plt.quiver(X1,X2,U,V, angles='xy', width=.004)\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "\n"
   ]
  },
